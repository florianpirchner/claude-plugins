{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "expert-teams/domains.schema.json",
  "title": "Domain pack index",
  "description": "domains/index.yaml of the plugin: the domain packs create can propose. Each pack lives in domains/<name>/SKILL.md.",
  "type": "object",
  "required": ["packs"],
  "additionalProperties": false,
  "properties": {
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "cues"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "description": { "type": "string", "minLength": 1, "description": "One sentence: which kind of project the pack is for." },
          "cues": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "Words and topics in the brainstorming that point to this pack."
          }
        }
      }
    }
  }
}
